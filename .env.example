# --- CONFIGURAÇÃO DE PRODUÇÃO (AI STUDIO / VM) ---

# DATABASE (Neon PostgreSQL)
# IMPORTANTE: Use a connection string do Neon (postgresql://...)
DATABASE_URL="postgresql://usuario:senha@host-neon/neondb?sslmode=require"

# INTEGRAÇÕES IA (Gemini)
GEMINI_API_KEY=

# AUTH PARA API
# Use uma chave forte com pelo menos 32 caracteres em produção
JWT_SECRET="troque_por_uma_chave_super_segura_com_no_minimo_32_caracteres"

# SERVER CONFIG
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173,https://portal.seudominio.com.br"

# CLIENT CONFIG (VITE)
VITE_API_URL="http://localhost:3000/api"
