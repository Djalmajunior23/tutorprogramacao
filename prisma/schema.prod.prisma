generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STUDENT") // "ADMIN", "TEACHER", "STUDENT"
  createdAt DateTime @default(now())

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
}

model StudentProfile {
  id        String @id @default(uuid())
  userId    String @unique
  classId   String?
  avatar    String?
  xp        Int    @default(0)
  level     Int    @default(1)

  user      User   @relation(fields: [userId], references: [id])
  class     Class? @relation(fields: [classId], references: [id])
  
  skills    StudentSkillSet[]
  progress  Progress[]
  attempts  ChallengeAttempt[]
  submissions CodeSubmission[]
  quizRuns  QuizRun[]
  achievements StudentAchievement[]
  recommendations Recommendation[]
  rankHistory RankingSnapshot[]
}

model StudentSkillSet {
  id           String @id @default(uuid())
  studentId    String
  conceptId    String
  score        Int    @default(0) // 0-100
  lastUpdated  DateTime @default(now())

  student      StudentProfile @relation(fields: [studentId], references: [id])
  concept      Concept @relation(fields: [conceptId], references: [id])

  @@unique([studentId, conceptId])
}

model TeacherProfile {
  id        String @id @default(uuid())
  userId    String @unique
  bio       String?

  user      User   @relation(fields: [userId], references: [id])
  classes   Class[]
}

model Class {
  id          String   @id @default(uuid())
  name        String
  course      String?
  teacherId   String
  createdAt   DateTime @default(now())

  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
  students    StudentProfile[]
  enrollments Enrollment[]
}

model Enrollment {
  id        String   @id @default(uuid())
  classId   String
  studentId String
  enrolledAt DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id])
  @@unique([classId, studentId])
}

model Achievement {
  id          String @id @default(uuid())
  title       String
  description String
  icon        String
  xpReward    Int

  students    StudentAchievement[]
}

model StudentAchievement {
  id            String @id @default(uuid())
  studentId     String
  achievementId String
  earnedAt      DateTime @default(now())

  student       StudentProfile @relation(fields: [studentId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([studentId, achievementId])
}

model ProgrammingLanguage {
  id          String @id @default(uuid())
  name        String @unique
  description String?
  
  syntaxExamples SyntaxExample[]
}

model Concept {
  id          String @id @default(uuid())
  name        String @unique
  description String
  
  syntaxExamples SyntaxExample[]
  skills        StudentSkillSet[]
  challenges    Challenge[]
}

model SyntaxExample {
  id           String @id @default(uuid())
  languageId   String
  conceptId    String
  code         String
  explanation  String?

  language     ProgrammingLanguage @relation(fields: [languageId], references: [id])
  concept      Concept @relation(fields: [conceptId], references: [id])

  @@unique([conceptId, languageId])
}

model LearningPath {
  id          String   @id @default(uuid())
  title       String
  description String
  difficulty  String
  xpReward    Int      @default(100)

  modules     Module[]
}

model Module {
  id             String @id @default(uuid())
  learningPathId String
  title          String
  description    String
  order          Int
  content        String
  xpReward       Int    @default(50)

  learningPath   LearningPath @relation(fields: [learningPathId], references: [id])
  lessons        Lesson[]
  challenges     Challenge[]
  progress       Progress[]
}

model Lesson {
  id          String @id @default(uuid())
  moduleId    String
  title       String
  content     String
  order       Int

  module      Module @relation(fields: [moduleId], references: [id])
}

model Challenge {
  id          String @id @default(uuid())
  moduleId    String?
  conceptId   String?
  title       String
  context     String
  command     String
  starterCode String
  expected    String?
  difficulty  String
  xpReward    Int    @default(50)
  type        String // "PSEUDOCODE", "CODE", "MULTIPLE_CHOICE"

  module      Module? @relation(fields: [moduleId], references: [id])
  concept     Concept? @relation(fields: [conceptId], references: [id])
  attempts    ChallengeAttempt[]
}

model Progress {
  id          String   @id @default(uuid())
  studentId   String
  moduleId    String
  status      String   @default("IN_PROGRESS") // "NOT_STARTED", "IN_PROGRESS", "COMPLETED"
  completedAt DateTime?

  student     StudentProfile @relation(fields: [studentId], references: [id])
  module      Module @relation(fields: [moduleId], references: [id])

  @@unique([studentId, moduleId])
}

model ChallengeAttempt {
  id          String   @id @default(uuid())
  studentId   String
  challengeId String
  code        String?
  answer      String?
  isCorrect   Boolean
  feedback    String
  score       Int
  createdAt   DateTime @default(now())

  student     StudentProfile @relation(fields: [studentId], references: [id])
  challenge   Challenge @relation(fields: [challengeId], references: [id])
}

model CodeSubmission {
  id          String   @id @default(uuid())
  studentId   String
  language    String
  code        String
  output      String?
  isCorrect   Boolean
  createdAt   DateTime @default(now())

  student     StudentProfile @relation(fields: [studentId], references: [id])
}

model QuizRun {
  id         String   @id @default(uuid())
  studentId  String
  title      String
  total      Int
  correct    Int
  score      Float
  createdAt  DateTime @default(now())

  student    StudentProfile @relation(fields: [studentId], references: [id])
  answers    QuizAnswer[]
}

model QuizAnswer {
  id         String @id @id @default(uuid())
  quizRunId  String
  question   String
  selected   String
  correct    String
  isCorrect  Boolean
  competency String?
  feedback   String?

  quizRun    QuizRun @relation(fields: [quizRunId], references: [id])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("NORMAL") // "NORMAL", "URGENTE"
  createdAt DateTime @default(now())
}

model Recommendation {
  id        String   @id @default(uuid())
  studentId String
  title     String
  reason    String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  student   StudentProfile @relation(fields: [studentId], references: [id])
}

model RankingSnapshot {
  id        String @id @default(uuid())
  studentId String
  rank      Int
  xp        Int
  createdAt DateTime @default(now())

  student   StudentProfile @relation(fields: [studentId], references: [id])
}
